from flask import Flask, render_template

app = Flask(__name__)

categorias = [
    "Cerámica",
    "Velas",
    "Cemento",
    "Sahumerios",
    "Porta sahumerios",
    "Esencias"
]


@app.route("/")
def inicio():
    return render_template(
        "index.html",
        categorias=categorias
    )


if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=5000,
        debug=True
    )
